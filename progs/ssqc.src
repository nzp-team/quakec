#pragma opcode enable RAND1
#pragma opcode enable RAND2
#pragma opcode enable C_FTOI
#pragma opcode enable C_ITOF
#pragma opcode enable BOUNDCHECK
#pragma opcode enable GLOBALADDRESS
#pragma opcode enable ADD_PIW
#pragma opcode enable LOADA_F
