#pragma opcode enable LOADP_S
#pragma opcode enable LOADP_ENT
#pragma opcode enable LOADP_FLD
#pragma opcode enable LOADP_FNC
#pragma opcode enable LOADP_I
#pragma opcode enable GLOAD_F
#pragma opcode enable GLOAD_S
#pragma opcode enable GLOAD_ENT
#pragma opcode enable GLOAD_FLD
#pragma opcode enable GLOAD_FNC
#pragma opcode enable GLOAD_I
#pragma opcode enable GSTOREP_F
#pragma opcode enable GSTOREP_V
#pragma opcode enable GSTOREP_S
#pragma opcode enable GSTOREP_ENT
#pragma opcode enable GSTOREP_FLD
#pragma opcode enable GSTOREP_FNC
#pragma opcode enable GSTOREP_I
#pragma opcode enable ADD_I
#pragma opcode enable MUL_I
#endif

