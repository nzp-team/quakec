#pragma opcode enable LOADA_S
#pragma opcode enable LOADA_ENT
#pragma opcode enable LOADA_FLD
#pragma opcode enable LOADA_FNC
#pragma opcode enable LOADA_I
#pragma opcode enable LOADP_F
